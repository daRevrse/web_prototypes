          {
           "id": "85278be",
           "elType": "widget",
           "settings": {
            "editor": "<p>Il y a plus de cinquante ans, dans les grands champs d'Agou, deux passionnés travaillaient la terre avec foi et détermination.</p>",
            "text_color": "#e7d8c0",
            "typography_typography": "custom",
