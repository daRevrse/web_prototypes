          {
           "id": "45df75e",
           "elType": "widget",
           "settings": {
            "editor": "<p>Deux bâtisseurs. Deux passionnés de la terre.</p>",
            "text_color": "#b6a489",
            "typography_typography": "custom",
            "typography_font_family": "Archivo",
            "typography_font_size": {
