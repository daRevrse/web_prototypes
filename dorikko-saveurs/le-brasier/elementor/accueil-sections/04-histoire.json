      {
       "id": "e6d926d",
       "elType": "widget",
       "settings": {
        "editor": "<p>Dorikko-Saveurs est née d'une conviction simple : une grande viande commence bien avant l'assiette. Tout part de notre ferme, où nos bêtes grandissent au rythme du terroir.</p>",
        "text_color": "#e7d8c0",
        "typography_typography": "custom",
        "typography_font_family": "Fira Sans",
        "typography_font_size": {
         "unit": "px",
         "size": 17,
         "sizes": []
        },
        "_margin": {
         "unit": "px",
         "top": "0",
         "right": "0",
         "bottom": "16",
         "left": "0",
         "isLinked": false
        }
       },
       "elements": [],
