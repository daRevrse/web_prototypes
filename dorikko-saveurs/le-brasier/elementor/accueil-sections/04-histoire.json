      },
      {
       "id": "dfabe17",
       "elType": "widget",
       "settings": {
        "editor": "<p>En cuisine, notre chef respecte ce travail : une maturation lente, une braise vive, des gestes précis. Rien de superflu — juste le produit, sublimé.</p>",
        "text_color": "#e7d8c0",
        "typography_typography": "custom",
